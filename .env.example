COMPOSE_PROJECT_NAME=property-rental-manager

APP_NAME=Property Rental Manager
APP_DEFAULT_LOCALE=pl
APP_SUPPORTED_LOCALES=pl,en
APP_DEFAULT_CURRENCY=PLN
APP_TIME_ZONE=Europe/Warsaw

POSTGRES_IMAGE=postgres:17
POSTGRES_DB=property_rental_manager
POSTGRES_USER=property_rental_manager
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=development
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/property_rental_manager
SPRING_DATASOURCE_USERNAME=property_rental_manager
SPRING_DATASOURCE_PASSWORD=change_me

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

JWT_SECRET_KEY=replace_with_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_STORAGE_DRIVER=local
APP_LOCAL_STORAGE_PATH=./data/storage
APP_MAX_UPLOAD_MB=10
APP_OVERDUE_CRON=0 0 2 * * *

VITE_APP_NAME=Property Rental Manager
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_LOCALE=pl
VITE_SUPPORTED_LOCALES=pl,en